NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: enables admin-created logins (invite/create user, bulk import) from the People tab.
# Without it, player profiles still import but login accounts are skipped.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
